<?xml version="1.0"?>
<!-- 早期练习用的单 link 模型, 已被 databot/datarobot.urdf.xacro 取代.
     保留仅作参考: 它没有轮子, 也没有 base_footprint, 不要用于实机.
     bringup.launch.py 与 display.launch.py 都加载 xacro 模型. -->
<robot name="datarobot">
    <!-- 机器人的身体部分 -->
    <link name="base_link">
        <!-- 部件的外观描述 -->
        <visual>
            <!-- 沿着自己几何中心的偏移和旋转量 -->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <!-- 几何形状 -->
            <geometry>
                <!-- 圆柱体半径 高度 -->
                <cylinder radius="0.5" length="1.8"/>
            </geometry>
            <!-- 颜色材质. material 必须带 name, 否则 urdf 解析器报错 -->
            <material name="white">
                <color rgba="1.0 1.0 1.0 0.5"/>
            </material>
        </visual>
    </link>
</robot>
